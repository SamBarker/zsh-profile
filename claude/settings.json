{
  "env": {
    "ANTHROPIC_VERTEX_PROJECT_ID": "itpc-ca-8588942395",
    "CLAUDE_CODE_USE_VERTEX": "1",
    "CLOUD_ML_REGION": "global"
  },
  "model": "claude-sonnet-5",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/sbarker/go/bin/chop\" hook"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -C ~/src/zsh-profile status --short | grep -q . && echo '{\"systemMessage\": \"zsh-profile has uncommitted changes — remember to commit before you go\"}' || true"
          }
        ]
      }
    ]
  },
  "effortLevel": "high",
  "autoCompactWindow": 400000,
  "autoCompactEnabled": true,
  "tui": "fullscreen"
}
