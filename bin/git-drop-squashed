#!/usr/bin/env zsh
# Usage: git-clean-squashed [--dry-run]
set -euo pipefail

DRY_RUN=false
[[ "${1:-}" == "--dry-run" ]] && DRY_RUN=true

git fetch upstream --prune
git fetch origin --prune

upstream_repo=$(git remote get-url upstream | sed 's|.*github\.com[:/]\(.*\)\.git|\1|; s|.*github\.com[:/]\(.*\)|\1|')

delete_branch() {
  local branch="$1" reason="$2"
  echo "$reason: $branch"
  if [[ "$DRY_RUN" == false ]]; then
    git branch -D "$branch"
    git push origin --delete "$branch" 2>/dev/null || true
  fi
}

git for-each-ref refs/heads/ --format='%(refname:short)' \
  | grep -v '^main$' \
  | while read -r branch; do
      # Fast path: all branch commits already reachable from upstream/main
      ahead=$(git rev-list upstream/main.."$branch" --count 2>/dev/null) || continue
      if [[ "$ahead" == "0" ]]; then
        delete_branch "$branch" "Already in main (merged)"
        continue
      fi

      merge_base=$(git merge-base upstream/main "$branch" 2>/dev/null) || continue
      # Synthesize a single squash commit with the same tree as the branch
      squash=$(git commit-tree "$(git rev-parse "$branch^{tree}")" -p "$merge_base" -m "_")
      # git cherry returns "-" prefix if an equivalent patch exists in upstream/main
      if [[ $(git cherry upstream/main "$squash") == "-"* ]]; then
        delete_branch "$branch" "Squash-merged"
      else
        # Fallback: check GitHub for a merged PR with this head branch
        pr_count=$(/opt/homebrew/bin/gh pr list \
          --repo "$upstream_repo" --head "$branch" \
          --state merged --json number --jq 'length' 2>/dev/null || echo "0")
        if [[ "$pr_count" -gt 0 ]]; then
          delete_branch "$branch" "PR merged (local tree diverged)"
        else
          echo "Still open:    $branch"
        fi
      fi
    done
